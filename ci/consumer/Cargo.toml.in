[package]
name = "pikaid-consumer"
version = "0.0.0"
edition = "2021"
publish = false

# Intentionally no documentation, examples or workspace membership: this crate
# exists only to prove that the *packaged* artifact is usable by an external
# project that has no access to the repository's source tree.
[dependencies]
pikaid = { path = "@PIKAID_PACKAGE_DIR@" }

[dev-dependencies]
serde_json = "1"
